# Copy to .env.local for local development. Never commit .env.local.
# Set the same variables in Vercel → Project → Settings → Environment Variables.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either name works:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Either name works (server only — never expose in browser):
SUPABASE_SECRET_KEY=your_secret_key
# SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# Google Maps — you need TWO separate keys in the same GCP project:
#
# 1) Browser key (HTTP referrer restrictions) → NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
#    Referrers to allow:
#      https://www.citygateshl.org/*
#      https://citygateshl.org/*
#      http://localhost:3000/*
#      https://*.vercel.app/*
#    Enable: Maps JavaScript API, Places API (New)
#
# 2) Server key (Application restriction: None) → GOOGLE_MAPS_SERVER_API_KEY
#    Do NOT set Android app or HTTP referrer restrictions on this key —
#    the website, phone app, and Vercel all call Places from the server.
#    Enable: Places API (New), Places API, Directions API, Geocoding API
#
# If you only have an Android-restricted key, add this app fingerprint in
# Google Cloud Console (APIs & Services → Credentials → the key → Android apps):
#    Package name: org.citygateshl.cityrun
#    SHA-1: BA:28:2B:BE:59:E2:2F:C5:2A:E4:59:01:F1:58:F0:E7:B3:B6:1A:EA
# A dedicated unrestricted GOOGLE_MAPS_SERVER_API_KEY is still the reliable fix.
#
# Do NOT use an Android-restricted or HTTP-referrer key for server-side requests
# unless the matching package/SHA-1 or referrer is also configured.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_maps_key
GOOGLE_MAPS_SERVER_API_KEY=your_server_maps_key

# City Run admin login (optional — defaults: cityrunadmin / citygateshl2026)
# CITY_RUN_ADMIN_USERNAME=
# CITY_RUN_ADMIN_PASSWORD=
# Optional session secrets (auto-derived from Supabase keys if omitted):
# CITY_RUN_ADMIN_SESSION_SECRET=
# CITY_RUN_RIDER_SESSION_SECRET=

# App URL (production)
NEXT_PUBLIC_APP_URL=https://www.citygateshl.org

# Web push (optional — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@citygateshl.com

# Paystack wallet top-ups (https://dashboard.paystack.com)
# Server only — used to initialize & verify payments
PAYSTACK_SECRET_KEY=
# Optional public key (current app uses server redirect; safe to expose if needed later)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Firebase (optional)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
